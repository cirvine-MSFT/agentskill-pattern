{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "type": "object",
  "required": ["schemaVersion", "observationId", "sessionId", "worktreeId", "candidateCommitSha", "blockId", "taskId", "repetition", "arm", "startDisposition", "status", "usage", "parentContext", "timing", "tools", "evaluation"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "observationId": { "type": "string", "minLength": 8 },
    "sessionId": { "type": "string", "minLength": 8 },
    "worktreeId": { "type": "string", "minLength": 8 },
    "candidateCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "blockId": { "type": "string", "minLength": 8 },
    "taskId": { "pattern": "^(P1[1-3]|M1[1-4])$" },
    "repetition": { "type": "integer", "minimum": 1 },
    "arm": { "enum": ["A1", "A2"] },
    "startDisposition": { "enum": ["not-started", "started"] },
    "status": { "enum": ["complete", "pre-start-failure", "timeout", "budget", "model-mismatch", "delegation-failure", "tool-misuse", "infrastructure-failure", "malformed-result"] },
    "usage": {
      "type": "object",
      "required": ["parent", "worker", "combinedCredits", "combinedNanoAiu", "totalModelTokens"],
      "properties": {
        "parent": { "$ref": "#/$defs/actorUsage" },
        "worker": { "$ref": "#/$defs/actorUsage" },
        "combinedCredits": { "type": ["number", "null"], "minimum": 0 },
        "combinedNanoAiu": { "type": ["integer", "null"], "minimum": 0 },
        "totalModelTokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "parentContext": {
      "type": "object",
      "required": ["cumulativeInputTokens", "peakInputTokens"],
      "properties": {
        "cumulativeInputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "peakInputTokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "timing": {
      "type": "object",
      "required": ["parentActiveMs", "workerActiveMs", "parentWaitMs", "wallMs"],
      "properties": {
        "parentActiveMs": { "type": ["integer", "null"], "minimum": 0 },
        "workerActiveMs": { "type": ["integer", "null"], "minimum": 0 },
        "parentWaitMs": { "type": ["integer", "null"], "minimum": 0 },
        "wallMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "tools": {
      "type": "object",
      "required": ["parentCalls", "workerCalls", "resultBytes"],
      "properties": {
        "parentCalls": { "type": ["integer", "null"], "minimum": 0 },
        "workerCalls": { "type": ["integer", "null"], "minimum": 0 },
        "resultBytes": { "type": ["integer", "null"], "minimum": 0 },
        "byActorAndName": { "type": "object" }
      }
    },
    "evaluation": { "type": ["object", "null"] },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "actorUsage": {
      "type": "object",
      "required": ["credits", "nanoAiu", "inputTokens", "outputTokens", "completions"],
      "properties": {
        "credits": { "type": ["number", "null"], "minimum": 0 },
        "nanoAiu": { "type": ["integer", "null"], "minimum": 0 },
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "completions": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
