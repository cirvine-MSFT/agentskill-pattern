{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.schema.json",
  "type": "object",
  "required": ["schemaVersion", "events"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "workerCallId": { "type": ["string", "null"] },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "actor", "kind"],
        "additionalProperties": false,
        "properties": {
          "seq": { "type": "integer", "minimum": 0 },
          "actor": { "enum": ["parent", "worker"] },
          "kind": { "enum": ["view", "edit", "task", "shell", "search", "terminal"] },
          "path": { "type": ["string", "null"] },
          "toolName": { "type": ["string", "null"] },
          "resultBytes": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
