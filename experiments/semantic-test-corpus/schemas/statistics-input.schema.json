{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "statistics-input.schema.json",
  "type": "object",
  "required": ["runs", "runRecords"],
  "additionalProperties": false,
  "properties": {
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runId", "blockId", "armId", "metricsPath"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"armId": {"const": 0}}},
            "else": {"required": ["evidenceContext"]}
          }
        ],
        "properties": {
          "runId": {"type": "string"},
          "blockId": {"type": "string"},
          "armId": {"type": "integer", "minimum": 0, "maximum": 4},
          "metricsPath": {"type": "string"},
          "evidenceContext": {
            "type": "object",
            "required": ["contractRoot", "stagingRoot", "evaluatorRoot"],
            "additionalProperties": false,
            "properties": {
              "contractRoot": {"type": "string"},
              "stagingRoot": {"type": "string"},
              "evaluatorRoot": {"type": "string"}
            }
          }
        }
      }
    },
    "runRecords": {"type": "array", "items": {"type": "object"}}
  }
}
