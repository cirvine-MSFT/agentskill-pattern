{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retry.schema.json",
  "type": "object",
  "required": [
    "formatVersion", "protocolId", "retryId", "runId", "fromAttemptId",
    "toAttemptId", "reason", "authorizedAt", "outcomesOpened", "sameTreatment"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 1},
    "protocolId": {"const": "semantic-test-corpus-execution-v2"},
    "retryId": {"type": "string", "minLength": 1},
    "runId": {"type": "string"},
    "fromAttemptId": {"type": "string", "minLength": 1},
    "toAttemptId": {"type": "string", "minLength": 1},
    "reason": {"const": "observed-model-mismatch"},
    "authorizedAt": {"type": "string"},
    "outcomesOpened": {"const": false},
    "sameTreatment": {"const": true}
  }
}
