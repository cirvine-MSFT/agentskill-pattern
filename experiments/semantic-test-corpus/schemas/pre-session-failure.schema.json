{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pre-session-failure.schema.json",
  "type": "object",
  "required": [
    "formatVersion", "protocolId", "failureId", "runId", "attemptedAt",
    "phase", "kickoffStarted", "sessionCreated", "reason", "receipt", "usage"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 1},
    "protocolId": {"enum": ["semantic-test-corpus-execution-v2", "semantic-test-corpus-execution-v3", "semantic-test-corpus-execution-v4", "semantic-test-corpus-execution-v5"]},
    "failureId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "pattern": "^(?:B|V[345]-B)\\d{2}-A[1-5]$"},
    "attemptedAt": {"type": "string"},
    "phase": {
      "enum": [
        "create_session", "preflight", "candidate-materialization",
        "sandbox-preparation", "kickoff-preparation"
      ]
    },
    "kickoffStarted": {"const": false},
    "sessionCreated": {"const": false},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "receipt": {
      "type": ["object", "null"]
    },
    "usage": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "protocolId": {"const": "semantic-test-corpus-execution-v2"},
        "phase": {"const": "create_session"},
        "evidence": {"maxItems": 0},
        "receipt": {
          "type": "object",
          "required": ["receiptKind", "receiptId", "path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "receiptKind": {"const": "authoritative-pre-session-failure"},
            "receiptId": {"type": "string", "minLength": 1},
            "path": {"type": "string", "pattern": "^[^/\\\\]+\\.receipt\\.json$"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "usage": {
          "type": "object",
          "required": ["aiCredits", "premiumRequests", "nanoAiu", "modelTokens", "completionCount"],
          "additionalProperties": false,
          "properties": {
            "aiCredits": {"const": 0},
            "premiumRequests": {"type": "null"},
            "nanoAiu": {"const": 0},
            "modelTokens": {"const": 0},
            "completionCount": {"const": 0}
          }
        }
      }
    },
    {
      "required": ["evidence"],
      "properties": {
        "protocolId": {"enum": ["semantic-test-corpus-execution-v3", "semantic-test-corpus-execution-v4", "semantic-test-corpus-execution-v5"]},
        "phase": {
          "enum": [
            "preflight", "candidate-materialization",
            "sandbox-preparation", "kickoff-preparation"
          ]
        },
        "receipt": {"type": "null"},
        "usage": {
          "type": "object",
          "required": [
            "aiCredits", "premiumRequests", "nanoAiu", "modelTokens",
            "completionCount", "unavailableReason"
          ],
          "additionalProperties": false,
          "properties": {
            "aiCredits": {"type": "null"},
            "premiumRequests": {"type": "null"},
            "nanoAiu": {"type": "null"},
            "modelTokens": {"type": "null"},
            "completionCount": {"type": "null"},
            "unavailableReason": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  ]
}
