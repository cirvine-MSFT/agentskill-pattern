{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "type": "object",
  "required": ["id", "input"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{2,79}$"},
    "description": {"type": "string", "minLength": 1},
    "input": {"type": "object"},
    "category": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "stagingFile": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^corpus-staging/scenarios/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "sourceTags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "decision-table",
          "boundary-partition",
          "pairwise-covering",
          "grammar-property",
          "constraint-solver",
          "held-out",
          "schema-pairwise",
          "schema-enumeration",
          "schema-optional",
          "public-contract-value",
          "generic-boundary",
          "generic-string-partition",
          "generic-collection-partition",
          "seeded-schema-property"
        ]
      }
    }
  }
}
