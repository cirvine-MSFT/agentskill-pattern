{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "type": "object",
  "required": ["id", "description", "input", "sourceTags"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "description": {"type": "string", "minLength": 1},
    "input": {"type": "object"},
    "sourceTags": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["decision-table", "boundary-partition", "pairwise-covering", "grammar-property", "constraint-solver", "held-out"]}
    }
  }
}
