{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "descriptive-input.schema.json",
  "type": "object",
  "required": ["formatVersion", "protocolId", "runs"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 1},
    "protocolId": {"const": "semantic-test-corpus-execution-v2"},
    "runs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 72,
      "items": {
        "type": "object",
        "required": ["runId", "blockId", "armId", "endpoints"],
        "additionalProperties": false,
        "properties": {
          "runId": {"type": "string", "pattern": "^B\\d{2}-A[0-5]$"},
          "blockId": {"type": "string", "pattern": "^B\\d{2}$"},
          "armId": {"type": "integer", "minimum": 0, "maximum": 5},
          "endpoints": {
            "type": "object",
            "required": [
              "promotionRate", "structuralValidityRate", "tracedRuleCount",
              "ruleCoverage", "tracedPathCount", "pathCoverage",
              "tracedInvariantCount", "invariantCoverage",
              "tracedDiagnosticCount", "diagnosticCoverage", "killedMutants",
              "mutantKillRate", "exactDuplicateCases", "semanticDuplicateCases",
              "semanticUniqueSignatures", "meanPairwiseJaccardDistance",
              "parentAiCredits", "workerAiCredits", "totalAiCredits",
              "parentPremiumRequests", "workerPremiumRequests",
              "totalPremiumRequests", "parentNanoAiu", "workerNanoAiu",
              "totalNanoAiu", "parentInputTokens", "workerInputTokens",
              "totalInputTokens", "parentOutputTokens", "workerOutputTokens",
              "totalOutputTokens", "parentCacheReadTokens",
              "workerCacheReadTokens", "totalCacheReadTokens",
              "parentCacheWriteTokens", "workerCacheWriteTokens",
              "totalCacheWriteTokens", "parentCachedTokens", "workerCachedTokens",
              "totalCachedTokens", "parentModelTokens", "workerModelTokens",
              "totalModelTokens", "parentCompletionCount",
              "workerCompletionCount", "totalCompletionCount",
              "parentCumulativeInputTokens", "parentPeakInputTokens",
              "toolSchemaCount", "toolCallCount", "toolResultCount",
              "toolResultBytes", "wallMs", "parentActiveMs", "workerActiveMs",
              "parentWaitMs", "sessionEvidenceAvailable",
              "modelEvidenceAvailable", "mechanismEvidenceAvailable",
              "deviationCount"
            ],
            "additionalProperties": false,
            "properties": {
              "promotionRate": {"$ref": "descriptive-measurement.schema.json"},
              "structuralValidityRate": {"$ref": "descriptive-measurement.schema.json"},
              "tracedRuleCount": {"$ref": "descriptive-measurement.schema.json"},
              "ruleCoverage": {"$ref": "descriptive-measurement.schema.json"},
              "tracedPathCount": {"$ref": "descriptive-measurement.schema.json"},
              "pathCoverage": {"$ref": "descriptive-measurement.schema.json"},
              "tracedInvariantCount": {"$ref": "descriptive-measurement.schema.json"},
              "invariantCoverage": {"$ref": "descriptive-measurement.schema.json"},
              "tracedDiagnosticCount": {"$ref": "descriptive-measurement.schema.json"},
              "diagnosticCoverage": {"$ref": "descriptive-measurement.schema.json"},
              "killedMutants": {"$ref": "descriptive-measurement.schema.json"},
              "mutantKillRate": {"$ref": "descriptive-measurement.schema.json"},
              "exactDuplicateCases": {"$ref": "descriptive-measurement.schema.json"},
              "semanticDuplicateCases": {"$ref": "descriptive-measurement.schema.json"},
              "semanticUniqueSignatures": {"$ref": "descriptive-measurement.schema.json"},
              "meanPairwiseJaccardDistance": {"$ref": "descriptive-measurement.schema.json"},
              "parentAiCredits": {"$ref": "descriptive-measurement.schema.json"},
              "workerAiCredits": {"$ref": "descriptive-measurement.schema.json"},
              "totalAiCredits": {"$ref": "descriptive-measurement.schema.json"},
              "parentPremiumRequests": {"$ref": "descriptive-measurement.schema.json"},
              "workerPremiumRequests": {"$ref": "descriptive-measurement.schema.json"},
              "totalPremiumRequests": {"$ref": "descriptive-measurement.schema.json"},
              "parentNanoAiu": {"$ref": "descriptive-measurement.schema.json"},
              "workerNanoAiu": {"$ref": "descriptive-measurement.schema.json"},
              "totalNanoAiu": {"$ref": "descriptive-measurement.schema.json"},
              "parentInputTokens": {"$ref": "descriptive-measurement.schema.json"},
              "workerInputTokens": {"$ref": "descriptive-measurement.schema.json"},
              "totalInputTokens": {"$ref": "descriptive-measurement.schema.json"},
              "parentOutputTokens": {"$ref": "descriptive-measurement.schema.json"},
              "workerOutputTokens": {"$ref": "descriptive-measurement.schema.json"},
              "totalOutputTokens": {"$ref": "descriptive-measurement.schema.json"},
              "parentCacheReadTokens": {"$ref": "descriptive-measurement.schema.json"},
              "workerCacheReadTokens": {"$ref": "descriptive-measurement.schema.json"},
              "totalCacheReadTokens": {"$ref": "descriptive-measurement.schema.json"},
              "parentCacheWriteTokens": {"$ref": "descriptive-measurement.schema.json"},
              "workerCacheWriteTokens": {"$ref": "descriptive-measurement.schema.json"},
              "totalCacheWriteTokens": {"$ref": "descriptive-measurement.schema.json"},
              "parentCachedTokens": {"$ref": "descriptive-measurement.schema.json"},
              "workerCachedTokens": {"$ref": "descriptive-measurement.schema.json"},
              "totalCachedTokens": {"$ref": "descriptive-measurement.schema.json"},
              "parentModelTokens": {"$ref": "descriptive-measurement.schema.json"},
              "workerModelTokens": {"$ref": "descriptive-measurement.schema.json"},
              "totalModelTokens": {"$ref": "descriptive-measurement.schema.json"},
              "parentCompletionCount": {"$ref": "descriptive-measurement.schema.json"},
              "workerCompletionCount": {"$ref": "descriptive-measurement.schema.json"},
              "totalCompletionCount": {"$ref": "descriptive-measurement.schema.json"},
              "parentCumulativeInputTokens": {"$ref": "descriptive-measurement.schema.json"},
              "parentPeakInputTokens": {"$ref": "descriptive-measurement.schema.json"},
              "toolSchemaCount": {"$ref": "descriptive-measurement.schema.json"},
              "toolCallCount": {"$ref": "descriptive-measurement.schema.json"},
              "toolResultCount": {"$ref": "descriptive-measurement.schema.json"},
              "toolResultBytes": {"$ref": "descriptive-measurement.schema.json"},
              "wallMs": {"$ref": "descriptive-measurement.schema.json"},
              "parentActiveMs": {"$ref": "descriptive-measurement.schema.json"},
              "workerActiveMs": {"$ref": "descriptive-measurement.schema.json"},
              "parentWaitMs": {"$ref": "descriptive-measurement.schema.json"},
              "sessionEvidenceAvailable": {"$ref": "descriptive-measurement.schema.json"},
              "modelEvidenceAvailable": {"$ref": "descriptive-measurement.schema.json"},
              "mechanismEvidenceAvailable": {"$ref": "descriptive-measurement.schema.json"},
              "deviationCount": {"$ref": "descriptive-measurement.schema.json"}
            }
          }
        }
      }
    }
  }
}
