{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-usage-export.schema.json",
  "type": "object",
  "required": ["formatVersion", "source", "rows"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 1},
    "source": {
      "type": "object",
      "required": ["database", "table", "exportedAt", "cliSessionId", "query"],
      "additionalProperties": false,
      "properties": {
        "database": {"const": "session-store.db"},
        "table": {"const": "assistant_usage_events"},
        "exportedAt": {"type": "string"},
        "cliSessionId": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1}
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "session_id", "turn_index", "agent_id", "parent_tool_call_id",
          "model", "input_tokens", "output_tokens", "cache_read_tokens",
          "cache_write_tokens", "reasoning_tokens", "total_nano_aiu",
          "request_multiplier", "duration_ms", "time_to_first_token_ms",
          "inter_token_latency_ms", "initiator", "api_endpoint",
          "reasoning_effort", "finish_reason", "content_filter_triggered",
          "token_details_json", "created_at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "session_id": {"type": "string", "minLength": 1},
          "turn_index": {"type": ["integer", "null"]},
          "agent_id": {"type": ["string", "null"]},
          "parent_tool_call_id": {"type": ["string", "null"]},
          "model": {"type": "string", "minLength": 1},
          "input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
          "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
          "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
          "total_nano_aiu": {"type": ["number", "null"], "minimum": 0},
          "request_multiplier": {"type": ["number", "null"], "minimum": 0},
          "duration_ms": {"type": ["number", "null"], "minimum": 0},
          "time_to_first_token_ms": {"type": ["number", "null"], "minimum": 0},
          "inter_token_latency_ms": {"type": ["number", "null"], "minimum": 0},
          "initiator": {"type": ["string", "null"]},
          "api_endpoint": {"type": ["string", "null"]},
          "reasoning_effort": {"type": ["string", "null"]},
          "finish_reason": {"type": ["string", "null"]},
          "content_filter_triggered": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
          "token_details_json": {"type": ["string", "null"]},
          "created_at": {"type": ["string", "null"]}
        }
      }
    }
  }
}
