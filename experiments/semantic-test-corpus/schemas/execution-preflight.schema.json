{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-preflight.schema.json",
  "type": "object",
  "required": [
    "formatVersion", "protocolId", "capturedAt", "cli", "surface",
    "configuredMcpServers", "usageStore", "profiles", "arms"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 2},
    "protocolId": {"const": "semantic-test-corpus-execution-v3"},
    "capturedAt": {"type": "string"},
    "cli": {
      "type": "object",
      "required": [
        "command", "version", "versionExitCode", "helpExitCode", "mcpListExitCode"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "versionExitCode": {"type": ["integer", "null"]},
        "helpExitCode": {"type": ["integer", "null"]},
        "mcpListExitCode": {"type": ["integer", "null"]}
      }
    },
    "surface": {
      "type": "object",
      "required": [
        "requiredFlagsPresent", "missingFlags", "fabricatedCreateSessionPresent"
      ],
      "additionalProperties": false,
      "properties": {
        "requiredFlagsPresent": {"type": "boolean"},
        "missingFlags": {"type": "array", "items": {"type": "string"}},
        "fabricatedCreateSessionPresent": {"const": false}
      }
    },
    "configuredMcpServers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "usageStore": {
      "type": "object",
      "required": ["path", "status", "columns", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["available", "unavailable"]},
        "columns": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": ["string", "null"]}
      }
    },
    "profiles": {
      "type": "object",
      "required": ["normalPinned", "fixedHaikuPinned"],
      "additionalProperties": false,
      "properties": {
        "normalPinned": {"type": "boolean"},
        "fixedHaikuPinned": {"type": "boolean"}
      }
    },
    "arms": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["armId", "status", "reasons"],
        "additionalProperties": false,
        "properties": {
          "armId": {"type": "integer", "minimum": 0, "maximum": 5},
          "status": {"type": "string", "enum": ["available", "unavailable"]},
          "reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
