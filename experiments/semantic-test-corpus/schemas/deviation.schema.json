{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deviation.schema.json",
  "type": "object",
  "required": [
    "formatVersion", "protocolId", "deviationId", "runId", "attemptId",
    "category", "observedAt", "description", "impact", "outcomesOpened"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 1},
    "protocolId": {"enum": ["semantic-test-corpus-execution-v2", "semantic-test-corpus-execution-v3", "semantic-test-corpus-execution-v4"]},
    "deviationId": {"type": "string", "minLength": 1},
    "runId": {"type": "string"},
    "attemptId": {"type": ["string", "null"]},
    "category": {
      "type": "string",
      "enum": ["mechanism", "model", "session", "evidence", "budget", "protocol"]
    },
    "observedAt": {"type": "string"},
    "description": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "enum": ["none", "descriptive-only", "exclude"]},
    "outcomesOpened": {"type": "boolean"}
  }
}
