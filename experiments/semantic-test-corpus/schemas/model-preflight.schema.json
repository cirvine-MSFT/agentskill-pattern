{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-preflight.schema.json",
  "type": "object",
  "required": ["capturedAt", "beforeOutcomeInspection", "cells"],
  "additionalProperties": false,
  "properties": {
    "capturedAt": {"type": "string"},
    "beforeOutcomeInspection": {"const": true},
    "cells": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["armId", "requestedModel", "observedModel", "atomicBinding", "sessionId", "evidence"],
        "additionalProperties": false,
        "properties": {
          "armId": {"type": "integer", "minimum": 1, "maximum": 4},
          "requestedModel": {"type": "string"},
          "observedModel": {"type": "string"},
          "atomicBinding": {"type": "boolean"},
          "sessionId": {"type": "string"},
          "workerSessionId": {"type": "string"},
          "workerObservedModel": {"type": "string"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
