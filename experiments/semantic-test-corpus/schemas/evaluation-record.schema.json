{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-record.schema.json",
  "type": "object",
  "required": [
    "formatVersion", "protocolId", "runId", "blockId", "armId", "attemptId",
    "snapshotPath", "snapshotSha256", "metricsPath", "metricsSha256",
    "executionSha256", "localEvidenceSha256", "modelPreflightSha256", "createdAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "protocolId": {"const": "semantic-test-corpus-execution-v5"}
        }
      },
      "then": {
        "required": [
          "disposition", "treatmentAdherent", "operationalSuccess",
          "failureKinds", "retryCount"
        ]
      }
    }
  ],
  "properties": {
    "formatVersion": {"const": 1},
    "protocolId": {"enum": ["semantic-test-corpus-execution-v2", "semantic-test-corpus-execution-v3", "semantic-test-corpus-execution-v4", "semantic-test-corpus-execution-v5"]},
    "runId": {"type": "string", "pattern": "^(?:B|V[345]-B)\\d{2}-A[0-5]$"},
    "blockId": {"type": "string", "pattern": "^B\\d{2}$"},
    "armId": {"type": "integer", "minimum": 0, "maximum": 5},
    "attemptId": {"type": ["string", "null"]},
    "snapshotPath": {"type": ["string", "null"], "minLength": 1},
    "snapshotSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "metricsPath": {"type": "string", "minLength": 1},
    "metricsSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executionSha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "localEvidenceSha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "modelPreflightSha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "createdAt": {"type": "string"},
    "disposition": {"type": "string", "enum": ["success", "measured-failure"]},
    "treatmentAdherent": {"type": "boolean"},
    "operationalSuccess": {"type": "boolean"},
    "failureKinds": {"type": "array", "items": {"type": "string"}},
    "retryCount": {"type": "integer", "const": 0}
  }
}
