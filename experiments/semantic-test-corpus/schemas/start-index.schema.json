{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "start-index.schema.json",
  "type": "object",
  "required": ["formatVersion", "protocolId", "captures"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 1},
    "protocolId": {"enum": ["semantic-test-corpus-execution-v2", "semantic-test-corpus-execution-v3"]},
    "captures": {
      "type": "array",
      "maxItems": 72,
      "items": {
        "type": "object",
        "required": [
          "runId", "blockId", "armId", "sequence", "disposition", "recordedAt",
          "sourcePath", "sourceSha256"
        ],
        "additionalProperties": false,
        "properties": {
          "runId": {"type": "string", "pattern": "^(?:B|V3-B)\\d{2}-A[0-5]$"},
          "blockId": {"type": "string", "pattern": "^B\\d{2}$"},
          "armId": {"type": "integer", "minimum": 0, "maximum": 5},
          "sequence": {"type": "integer", "minimum": 1, "maximum": 72},
          "disposition": {"type": "string", "enum": ["started", "unavailable"]},
          "recordedAt": {"type": "string"},
          "startedAt": {"type": ["string", "null"]},
          "sourcePath": {"type": "string", "minLength": 1},
          "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
