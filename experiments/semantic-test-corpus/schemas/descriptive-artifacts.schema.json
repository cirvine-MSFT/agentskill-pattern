{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "descriptive-artifacts.schema.json",
  "type": "object",
  "required": ["formatVersion", "protocolId", "runs"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 1},
    "protocolId": {"const": "semantic-test-corpus-execution-v2"},
    "runs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 72,
      "items": {
        "type": "object",
        "required": [
          "runId", "blockId", "armId", "snapshotPath", "metricsPath",
          "executionPath", "localEvidencePath", "modelPreflightPath", "candidateRoot",
          "evaluationPath"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"armId": {"const": 0}}},
            "then": {
              "properties": {
                "executionPath": {"type": "string", "minLength": 1},
                "localEvidencePath": {"type": "null"},
                "modelPreflightPath": {"type": "null"},
                "candidateRoot": {"type": "null"}
              }
            },
            "else": {
              "properties": {
                "executionPath": {"type": "null"},
                "localEvidencePath": {"type": "string", "minLength": 1},
                "modelPreflightPath": {"type": "string", "minLength": 1},
                "candidateRoot": {"type": "string", "minLength": 1}
              }
            }
          }
        ],
        "properties": {
          "runId": {"type": "string", "pattern": "^B\\d{2}-A[0-5]$"},
          "blockId": {"type": "string", "pattern": "^B\\d{2}$"},
          "armId": {"type": "integer", "minimum": 0, "maximum": 5},
          "snapshotPath": {"type": "string", "minLength": 1},
          "metricsPath": {"type": "string", "minLength": 1},
          "executionPath": {"type": ["string", "null"]},
          "localEvidencePath": {"type": ["string", "null"]},
          "modelPreflightPath": {"type": ["string", "null"]},
          "candidateRoot": {"type": ["string", "null"]},
          "evaluationPath": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
