{
  "setId": "semantic-held-out-2026-07-29",
  "cases": [
    {
      "id": "H001",
      "ruleId": "H-PRECEDENCE-PROD-FORMAT",
      "input": {
        "version": 1,
        "service": {"name": "api", "environment": "prod", "region": "eastus"},
        "logging": {"level": "info", "pretty": true},
        "cache": {"enabled": false},
        "database": {"engine": "postgres", "host": "db", "name": "app", "ssl": true},
        "retries": {"mode": "fixed", "maxAttempts": 3, "delayMs": 500},
        "security": {"allowedOrigins": ["https://prod.example.test"]},
        "features": {"flags": {"alpha": true}}
      },
      "expect": {
        "status": "ok",
        "configPaths": {"observability.format": "json"},
        "diagnosticIds": ["W-PROD-PRETTY"],
        "requiredTracePaths": ["P-LOG-FORMAT-PROD-FORCED-JSON"]
      }
    },
    {
      "id": "H002",
      "ruleId": "H-EFFECTIVE-PORT-CONFLICT",
      "input": {
        "version": 1,
