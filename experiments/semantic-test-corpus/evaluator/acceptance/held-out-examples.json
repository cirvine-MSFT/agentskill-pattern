    },
    {
      "id": "H004",
      "ruleId": "H-CORS-CANONICALIZATION",
      "input": {
        "version": 1,
        "service": {"name": "api", "environment": "test", "region": "westeurope"},
        "logging": {"level": "warn", "pretty": false},
        "cache": {"enabled": true, "provider": "memory", "ttlSeconds": 1},
        "database": {"engine": "mysql", "host": "db", "name": "app", "ssl": false},
        "retries": {"mode": "fixed", "maxAttempts": 2, "delayMs": 100},
        "security": {"allowedOrigins": ["https://EXAMPLE.test", "https://example.test/"]},
        "features": {"flags": {}}
      },
      "expect": {
        "status": "ok",
        "configPaths": {"http.cors.origins": ["https://example.test"]},
        "diagnosticIds": ["W-ORIGIN-DEDUP"],
        "requiredTracePaths": ["P-CORS-NORMALIZED"]
      }
    },
    {
      "id": "H005",
      "ruleId": "H-RETRY-CAP",
      "input": {
        "version": 1,
        "service": {"name": "api", "environment": "dev", "region": "southeastasia"},
        "logging": {"level": "error", "pretty": false},
        "cache": {"enabled": true, "provider": "redis", "ttlSeconds": 86400, "endpoint": "rediss://cache:6380/0"},
        "database": {"engine": "postgres", "host": "db", "port": 5433, "name": "app", "ssl": false},
        "retries": {"mode": "exponential", "maxAttempts": 10, "delayMs": 10000},
        "security": {"allowedOrigins": ["https://example.test"]},
        "features": {"flags": {"stable": true}}
      },
      "expect": {
        "status": "ok",
        "configPaths": {"resilience.maxDelayMs": 60000},
