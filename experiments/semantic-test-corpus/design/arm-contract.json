{
  "protocolId": "semantic-test-corpus-execution-v2",
  "preregistrationVersion": "2.0.0",
  "amends": "protocol.md v1.4.0",
  "normativeAmendment": "execution-amendment-v2.md",
  "fixedModels": {
    "frontier": "gpt-5.6-sol",
    "cheap": "claude-haiku-4.5"
  },
  "commonContract": {
    "caseCount": 60,
    "output": "staging/<run-id>.json",
    "schema": "schemas/staging.schema.json",
    "wallClockMinutes": 30,
    "maximumToolCalls": 120,
    "maximumTotalModelTokens": 100000,
    "executionLocation": "local",
    "kickoffMode": "autopilot",
    "sessionCreation": "atomic-create-session-with-seeded-kickoff",
    "sourcePin": "design/source-pin.json",
    "freshSessionEvidence": "exact app project session ID plus internal CLI session ID",
    "acceptanceBoundary": "external-evaluator-not-mounted",
    "expectedOutputPolicy": "oracle-after-promotion-only",
    "taskArtifact": "task/shared-task-prompt.txt",
    "agentName": "semantic-test-corpus",
    "mcpServer": "semantic-corpus",
    "toolSurface": [
      "semantic-corpus/list_contract_files",
      "semantic-corpus/read_contract_file",
      "semantic-corpus/write_scenario_input",
      "semantic-corpus/write_scenario_manifest"
    ],
    "sourceOutput": "corpus-staging/",
    "adapter": {
      "role": "evaluator",
      "artifact": "evaluator/local-adapter-v2.mjs",
      "runsAfterModelCompletion": true,
      "snapshotHash": "sha256-canonical-staging-bytes"
    },
    "metrics": {
      "role": "evaluator",
      "artifact": "evaluator/metrics.mjs",
      "schema": "schemas/metrics-artifact.schema.json",
      "runRecordBinding": "metrics.sha256",
      "evidence": "local-hash-bound-unsigned"
    },
    "localEvidence": {
      "tier": "descriptive-local-v1",
      "collector": "scripts/collect-local-evidence.mjs",
      "validator": "scripts/validate-local-evidence.mjs",
      "modelPreflight": "scripts/preflight-local-model.mjs",
      "signed": false,
      "complianceProof": false,
      "requiredBindings": [
        "appProjectSessionId",
        "cliSessionId",
        "eventsSha256",
        "usageSha256",
        "sourceCommit",
        "sourceTree",
        "sourceBlobIds",
        "terminalCommit",
        "candidateSnapshotSha256"
      ]
    },
    "platformAudit": {
      "adapter": "scripts/platform-audit-adapter.mjs",
      "capturedFixtures": "fixtures/platform-audit/captures.json",
      "unsignedJsonlPolicy": "protocol-cell-unavailable",
      "currentSmokeAvailability": {
        "inline": false,
        "delegated": false,
        "reason": "Copilot CLI JSONL lacks detached signature and signed policy/filesystem/run boundaries"
      }
    }
  },
  "delegationContract": {
    "artifact": ".github/skills/semantic-test-corpus/SKILL.md",
    "registeredPath": ".github/skills/semantic-test-corpus/SKILL.md",
    "invocation": "semantic-test-corpus",
    "agentName": "semantic-test-corpus",
    "workspaceOwnership": "actual-caller-confined-staging",
    "successReturn": "corpus-staging/manifest.json - <count> scenarios - SUCCESS",
    "failureReturn": "corpus-staging - <written-count> scenarios - FAILURE: <reason>",
    "parentCorpusReadAllowed": false,
    "parentToolSurface": ["agent/semantic-test-corpus"],
    "toolSurface": [
      "semantic-corpus/list_contract_files",
      "semantic-corpus/read_contract_file",
      "semantic-corpus/write_scenario_input",
      "semantic-corpus/write_scenario_manifest"
    ]
  },
  "arms": [
    {"id": 0, "name": "general deterministic script", "modelTier": "none", "delegated": false, "model": null, "generator": "baseline/general-generate.mjs"},
    {"id": 1, "name": "frontier inline", "modelTier": "frontier", "delegated": false, "model": "gpt-5.6-sol"},
    {"id": 2, "name": "frontier same-model delegated", "modelTier": "frontier", "delegated": true, "model": "gpt-5.6-sol", "workerModel": "gpt-5.6-sol", "delegationContract": "delegationContract"},
    {"id": 3, "name": "cheap inline", "modelTier": "cheap", "delegated": false, "model": "claude-haiku-4.5"},
    {"id": 4, "name": "cheap delegated via Skill/agent", "modelTier": "cheap", "delegated": true, "model": "claude-haiku-4.5", "workerModel": "claude-haiku-4.5", "delegationContract": "delegationContract"},
    {
      "id": 5,
      "name": "frontier parent to cheap same-agent worker",
      "modelTier": "mixed",
      "delegated": true,
      "model": "gpt-5.6-sol",
      "workerModel": "claude-haiku-4.5",
      "delegationContract": "delegationContract",
      "agentName": "semantic-test-corpus",
      "workerModelOverride": "claude-haiku-4.5",
      "unavailablePolicy": "If the same semantic-test-corpus invocation cannot accept or authenticate this worker model override, the run is unavailable; no alternate agent or mechanism is permitted."
    }
  ]
}
