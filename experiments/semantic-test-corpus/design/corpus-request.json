        "additionalProperties": false,
        "required": ["mode", "maxAttempts", "delayMs"],
        "properties": {
          "mode": {"type": "string", "maxLength": 11, "enum": ["fixed", "exponential"]},
          "maxAttempts": {"type": "integer", "minimum": -100000, "maximum": 100000},
          "delayMs": {"type": "integer", "minimum": -100000, "maximum": 100000}
        }
      },
      "security": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allowedOrigins"],
        "properties": {
          "allowedOrigins": {
            "type": "array",
            "minItems": 0,
            "maxItems": 16,
            "uniqueItems": false,
            "items": {"type": "string", "maxLength": 512}
          }
        }
      },
      "features": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flags"],
        "properties": {
          "flags": {
            "type": "object",
            "additionalProperties": false,
