{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cirvine-MSFT/agentskill-pattern/ascii-art-powershell-cli/blind-bundle.schema.json",
  "title": "Bound blinded judge assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolId",
    "blindId",
    "judgeBlock",
    "scheduleId",
    "runId",
    "sourceArtifactBundleSha256",
    "blindBundleSha256"
  ],
  "properties": {
    "protocolId": { "const": "ascii-art-powershell-cli-v1" },
    "blindId": { "type": "string", "pattern": "^B[0-9]{4}$" },
    "judgeBlock": { "type": "integer", "minimum": 1, "maximum": 6 },
    "scheduleId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)$" },
    "runId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)-A[1-2]$" },
    "sourceArtifactBundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "blindBundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
