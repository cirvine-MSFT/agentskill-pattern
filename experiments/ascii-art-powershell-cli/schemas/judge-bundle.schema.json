{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cirvine-MSFT/agentskill-pattern/ascii-art-powershell-cli/judge-bundle.schema.json",
  "title": "Blinded judge bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolId",
    "blindId",
    "scheduleId",
    "promptId",
    "selectedRunId",
    "artifactBundleSha256",
    "blindBundleSha256",
    "files"
  ],
  "properties": {
    "protocolId": { "const": "ascii-art-powershell-cli-v1" },
    "blindId": { "type": "string", "pattern": "^B[0-9]{4}$" },
    "scheduleId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)$" },
    "promptId": { "type": "string", "pattern": "^P(0[1-9]|10)$" },
    "selectedRunId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)-A[1-2]$" },
    "artifactBundleSha256": { "$ref": "#/$defs/sha256" },
    "blindBundleSha256": { "$ref": "#/$defs/sha256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
