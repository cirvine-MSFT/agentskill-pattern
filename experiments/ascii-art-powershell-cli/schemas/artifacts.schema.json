{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cirvine-MSFT/agentskill-pattern/ascii-art-powershell-cli/artifacts.schema.json",
  "title": "Observation artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolId", "runId", "scheduleId", "sessionId", "terminalCommitSha", "bundlePath", "bundleSha256", "files"],
  "properties": {
    "protocolId": { "const": "ascii-art-powershell-cli-v1" },
    "runId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)-A[1-2]$" },
    "scheduleId": { "type": "string" },
    "sessionId": { "type": "string", "minLength": 1 },
    "terminalCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "bundlePath": { "type": "string", "minLength": 1 },
    "bundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "role": { "enum": ["source", "fixture_test", "banner", "diff"] }
        }
      }
    }
  }
}
