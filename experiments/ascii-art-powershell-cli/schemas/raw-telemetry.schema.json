{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cirvine-MSFT/agentskill-pattern/ascii-art-powershell-cli/raw-telemetry.schema.json",
  "title": "Raw benchmark telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolId", "runId", "scheduleId", "collectedAt", "metrics", "models", "tools", "compaction", "routing", "rawSources"],
  "properties": {
    "protocolId": { "const": "ascii-art-powershell-cli-v1" },
    "runId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)-A[1-2]$" },
    "scheduleId": { "type": "string" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalSessionAiCredits",
        "totalSessionNanoAiu",
        "parentNanoAiu",
        "parentCumulativeInputTokens",
        "parentPeakInputTokens",
        "parentOutputTokens",
        "specialistCumulativeInputTokens",
        "specialistPeakInputTokens",
        "specialistOutputTokens",
        "exposedToolCount",
        "toolCallCount",
        "toolResultCount",
        "compactReturnBytes",
        "wallLatencyMs",
        "parentActiveLatencyMs",
        "specialistLatencyMs",
        "parentWaitLatencyMs"
      ],
      "properties": {
        "totalSessionAiCredits": { "$ref": "#/$defs/metric" },
        "totalSessionNanoAiu": { "$ref": "#/$defs/metric" },
        "parentNanoAiu": { "$ref": "#/$defs/metric" },
        "parentCumulativeInputTokens": { "$ref": "#/$defs/metric" },
        "parentPeakInputTokens": { "$ref": "#/$defs/metric" },
        "parentOutputTokens": { "$ref": "#/$defs/metric" },
        "specialistCumulativeInputTokens": { "$ref": "#/$defs/metric" },
        "specialistPeakInputTokens": { "$ref": "#/$defs/metric" },
        "specialistOutputTokens": { "$ref": "#/$defs/metric" },
        "exposedToolCount": { "$ref": "#/$defs/metric" },
        "toolCallCount": { "$ref": "#/$defs/metric" },
        "toolResultCount": { "$ref": "#/$defs/metric" },
        "compactReturnBytes": { "$ref": "#/$defs/metric" },
        "wallLatencyMs": { "$ref": "#/$defs/metric" },
        "parentActiveLatencyMs": { "$ref": "#/$defs/metric" },
        "specialistLatencyMs": { "$ref": "#/$defs/metric" },
        "parentWaitLatencyMs": { "$ref": "#/$defs/metric" }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "requestedModel", "observedModel", "sessionId", "aiCredits", "nanoAiu", "inputTokens", "peakInputTokens", "outputTokens", "cachedTokens"],
        "properties": {
          "role": { "enum": ["parent", "specialist"] },
          "requestedModel": { "type": "string" },
          "observedModel": { "type": "string" },
          "sessionId": { "type": "string" },
          "aiCredits": { "$ref": "#/$defs/metric" },
          "nanoAiu": { "$ref": "#/$defs/metric" },
          "inputTokens": { "$ref": "#/$defs/metric" },
          "peakInputTokens": { "$ref": "#/$defs/metric" },
          "outputTokens": { "$ref": "#/$defs/metric" },
          "cachedTokens": { "$ref": "#/$defs/metric" }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "sequence", "name", "callId", "startedAt", "completedAt", "success", "resultBytes"],
        "properties": {
          "sessionId": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "callId": { "type": "string" },
          "startedAt": { "type": ["string", "null"], "format": "date-time" },
          "completedAt": { "type": ["string", "null"], "format": "date-time" },
          "success": { "type": ["boolean", "null"] },
          "resultBytes": { "$ref": "#/$defs/metric" }
        }
      }
    },
    "compaction": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "sequence", "timestamp", "returnBytes", "sourceEventId"],
        "properties": {
          "sessionId": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 1 },
          "timestamp": { "type": ["string", "null"], "format": "date-time" },
          "returnBytes": { "$ref": "#/$defs/metric" },
          "sourceEventId": { "type": ["string", "null"] }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "specialist", "delegationEvidence"],
      "properties": {
        "parent": { "$ref": "#/$defs/routingRef" },
        "specialist": {
          "oneOf": [
            { "$ref": "#/$defs/routingRef" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": { "const": "not_applicable" },
                "reason": { "const": "control_condition" }
              }
            }
          ]
        },
        "delegationEvidence": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "callEventId", "resultEventId", "requestedAt", "returnedAt", "unavailableReason"],
              "properties": {
                "status": { "const": "available" },
                "callEventId": { "type": "string", "minLength": 1 },
                "resultEventId": { "type": "string", "minLength": 1 },
                "requestedAt": { "type": "string", "format": "date-time" },
                "returnedAt": { "type": "string", "format": "date-time" },
                "unavailableReason": { "type": "null" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "callEventId", "resultEventId", "requestedAt", "returnedAt", "unavailableReason"],
              "properties": {
                "status": { "const": "unavailable" },
                "callEventId": { "type": "null" },
                "resultEventId": { "type": "null" },
                "requestedAt": { "type": "null" },
                "returnedAt": { "type": "null" },
                "unavailableReason": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "callEventId", "resultEventId", "requestedAt", "returnedAt", "unavailableReason"],
              "properties": {
                "status": { "const": "not_applicable" },
                "callEventId": { "type": "null" },
                "resultEventId": { "type": "null" },
                "requestedAt": { "type": "null" },
                "returnedAt": { "type": "null" },
                "unavailableReason": { "type": "null" }
              }
            }
          ]
        }
      }
    },
    "rawSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "collector", "collectedBySessionId"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "collector": { "type": "string" },
          "collectedBySessionId": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "unit", "source", "unavailableReason"],
          "properties": {
            "status": { "const": "available" },
            "value": { "type": "number" },
            "unit": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "unavailableReason": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "unit", "source", "unavailableReason"],
          "properties": {
            "status": { "const": "unavailable" },
            "value": { "type": "null" },
            "unit": { "type": "string", "minLength": 1 },
            "source": { "type": ["string", "null"] },
            "unavailableReason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "unit", "source", "unavailableReason"],
          "properties": {
            "status": { "const": "not_applicable" },
            "value": { "type": "null" },
            "unit": { "type": "string", "minLength": 1 },
            "source": { "type": "null" },
            "unavailableReason": { "type": "null" }
          }
        }
      ]
    },
    "routingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "requestedModel", "observedModel", "sourceEventIds"],
      "properties": {
        "sessionId": { "type": "string" },
        "requestedModel": { "type": "string" },
        "observedModel": { "type": "string" },
        "sourceEventIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
