{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cirvine-MSFT/agentskill-pattern/ascii-art-powershell-cli/run-manifest.schema.json",
  "title": "Benchmark run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolId",
    "runId",
    "scheduleId",
    "promptId",
    "repetition",
    "condition",
    "conditionInstruction",
    "conditionEvidence",
    "execution",
    "environment",
    "sessions",
    "refs",
    "workspace",
    "timestamps",
    "completion",
    "exclusion"
  ],
  "properties": {
    "protocolId": { "const": "ascii-art-powershell-cli-v1" },
    "runId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)-A[1-2]$" },
    "scheduleId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)$" },
    "promptId": { "type": "string", "pattern": "^P(0[1-9]|10)$" },
    "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
    "condition": { "enum": ["control", "treatment"] },
    "conditionInstruction": {
      "enum": [
        "Complete the task yourself. Do not create or use nested sessions. Inspect and edit the fixture, create the required banner asset, and run repository-owned tests.",
        "Complete the implementation and testing yourself. Delegate only creation of the required banner asset to one fresh nested session using model `claude-haiku-4.5`; instruct it to write that one asset directly into the workspace. Do not delegate code, tests, inspection, integration, or any other work. Wait for the nested session and then inspect/integrate its asset."
      ]
    },
    "conditionEvidence": { "$ref": "#/$defs/conditionEvidence" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block", "position", "attempt", "rootSessionId", "coordinatorSessionId"],
      "properties": {
        "block": { "type": "integer", "minimum": 1, "maximum": 6 },
        "position": { "type": "integer", "minimum": 1, "maximum": 10 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
        "rootSessionId": { "type": "string", "minLength": 1 },
        "coordinatorSessionId": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copilotCliVersion", "hostImage", "operatingSystem", "powershellVersion", "nodeVersion"],
      "properties": {
        "copilotCliVersion": { "type": "string", "minLength": 1 },
        "hostImage": { "type": "string", "minLength": 1 },
        "operatingSystem": { "const": "Windows_NT" },
        "powershellVersion": { "type": "string", "minLength": 1 },
        "nodeVersion": { "type": "string", "minLength": 1 }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "specialist"],
      "properties": {
        "parent": { "$ref": "#/$defs/sessionRef" },
        "specialist": {
          "oneOf": [
            { "$ref": "#/$defs/sessionRef" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": { "const": "not_applicable" },
                "reason": { "const": "control_condition" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": { "const": "unavailable" },
                "reason": { "const": "specialist_session_not_created" }
              }
            }
          ]
        }
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmarkCommitSha",
        "fixtureLockSha256",
        "promptsSha256",
        "initialTreeSha",
        "terminalCommitSha",
        "artifactBundleSha256"
      ],
      "properties": {
        "benchmarkCommitSha": { "$ref": "#/$defs/gitSha" },
        "fixtureLockSha256": { "$ref": "#/$defs/sha256" },
        "promptsSha256": { "$ref": "#/$defs/sha256" },
        "initialTreeSha": { "$ref": "#/$defs/gitSha" },
        "terminalCommitSha": { "$ref": "#/$defs/gitSha" },
        "artifactBundleSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "branch"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "promptSentAt", "completedAt"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "promptSentAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "completion": { "enum": ["completed", "failed", "timed_out", "interrupted"] },
    "exclusion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["excluded", "reason", "retryOf", "retryId"],
          "properties": {
            "excluded": { "const": false },
            "reason": { "type": "null" },
            "retryOf": { "type": ["string", "null"] },
            "retryId": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["excluded", "reason", "retryOf", "retryId"],
          "properties": {
            "excluded": { "const": true },
            "reason": {
              "enum": [
                "session_creation_failure",
                "hash_mismatch",
                "wrong_model",
                "non_fresh_session",
                "telemetry_collection_failure",
                "external_interruption",
                "required_tool_unavailable"
              ]
            },
            "retryOf": { "type": ["string", "null"] },
            "retryId": { "type": ["string", "null"] }
          }
        }
      ]
    }
  },
  "$defs": {
    "conditionEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "delegationCallEventIds",
            "delegationResultEventIds",
            "specialistToolCallEventIds",
            "specialistToolResultEventIds",
            "specialistFileChangeEventIds",
            "unavailableReason"
          ],
          "properties": {
            "status": { "const": "available" },
            "delegationCallEventIds": { "$ref": "#/$defs/eventIds" },
            "delegationResultEventIds": { "$ref": "#/$defs/eventIds" },
            "specialistToolCallEventIds": { "$ref": "#/$defs/eventIds" },
            "specialistToolResultEventIds": { "$ref": "#/$defs/eventIds" },
            "specialistFileChangeEventIds": { "$ref": "#/$defs/eventIds" },
            "unavailableReason": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "delegationCallEventIds",
            "delegationResultEventIds",
            "specialistToolCallEventIds",
            "specialistToolResultEventIds",
            "specialistFileChangeEventIds",
            "unavailableReason"
          ],
          "properties": {
            "status": { "const": "unavailable" },
            "delegationCallEventIds": { "$ref": "#/$defs/emptyEventIds" },
            "delegationResultEventIds": { "$ref": "#/$defs/emptyEventIds" },
            "specialistToolCallEventIds": { "$ref": "#/$defs/emptyEventIds" },
            "specialistToolResultEventIds": { "$ref": "#/$defs/emptyEventIds" },
            "specialistFileChangeEventIds": { "$ref": "#/$defs/emptyEventIds" },
            "unavailableReason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "eventIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "emptyEventIds": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string", "minLength": 1 }
    },
    "sessionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "requestedModel", "observedModel"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "requestedModel": { "type": "string", "minLength": 1 },
        "observedModel": { "type": "string", "minLength": 1 }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
