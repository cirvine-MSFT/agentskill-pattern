{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cirvine-MSFT/agentskill-pattern/ascii-art-powershell-cli/judge-assignment.schema.json",
  "title": "Materialized blinded judge assignments",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolId", "designSha256", "assignments"],
  "properties": {
    "protocolId": { "const": "ascii-art-powershell-cli-v1" },
    "designSha256": { "$ref": "#/$defs/sha256" },
    "assignments": {
      "type": "array",
      "minItems": 66,
      "maxItems": 66,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blindId",
          "block",
          "presentationPosition",
          "scheduleId",
          "promptId",
          "selectedRunId",
          "artifactBundleSha256",
          "blindBundleSha256",
          "judgeSessionId",
          "duplicateOfBlindId"
        ],
        "properties": {
          "blindId": { "type": "string", "pattern": "^B[0-9]{4}$" },
          "block": { "type": "integer", "minimum": 1, "maximum": 6 },
          "presentationPosition": { "type": "integer", "minimum": 1, "maximum": 11 },
          "scheduleId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)$" },
          "promptId": { "type": "string", "pattern": "^P(0[1-9]|10)$" },
          "selectedRunId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)-A[1-2]$" },
          "artifactBundleSha256": { "$ref": "#/$defs/sha256" },
          "blindBundleSha256": { "$ref": "#/$defs/sha256" },
          "judgeSessionId": { "type": "string", "minLength": 1 },
          "duplicateOfBlindId": { "type": ["string", "null"], "pattern": "^B[0-9]{4}$" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
