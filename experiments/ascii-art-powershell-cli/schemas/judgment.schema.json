{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cirvine-MSFT/agentskill-pattern/ascii-art-powershell-cli/judgment.schema.json",
  "title": "Blinded benchmark judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolId",
    "blindId",
    "block",
    "scheduleId",
    "selectedRunId",
    "artifactBundleSha256",
    "blindBundleSha256",
    "judgeSessionId",
    "judgeModel",
    "scores",
    "overall",
    "rationale",
    "duplicateOf"
  ],
  "properties": {
    "protocolId": { "const": "ascii-art-powershell-cli-v1" },
    "blindId": { "type": "string", "pattern": "^B[0-9]{4}$" },
    "block": { "type": "integer", "minimum": 1, "maximum": 6 },
    "scheduleId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)$" },
    "selectedRunId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)-A[1-2]$" },
    "artifactBundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "blindBundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "judgeSessionId": { "type": "string", "minLength": 1 },
    "judgeModel": { "const": "gpt-5.6-sol" },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "codeQuality", "integration", "recognizability", "composition", "cleanliness"],
      "properties": {
        "function": { "$ref": "#/$defs/score" },
        "codeQuality": { "$ref": "#/$defs/score" },
        "integration": { "$ref": "#/$defs/score" },
        "recognizability": { "$ref": "#/$defs/score" },
        "composition": { "$ref": "#/$defs/score" },
        "cleanliness": { "$ref": "#/$defs/score" }
      }
    },
    "overall": { "type": "number", "minimum": 1, "maximum": 5, "multipleOf": 0.01 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "duplicateOf": { "type": ["string", "null"], "pattern": "^B[0-9]{4}$" }
  },
  "$defs": {
    "score": { "type": "integer", "minimum": 1, "maximum": 5 }
  }
}
