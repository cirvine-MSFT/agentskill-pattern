{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cirvine-MSFT/agentskill-pattern/ascii-art-powershell-cli/artifact-bundle.schema.json",
  "title": "Authenticated metadata-safe source artifact bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolId", "promptId", "prompt", "deterministic", "files"],
  "properties": {
    "protocolId": { "const": "ascii-art-powershell-cli-v1" },
    "promptId": { "type": "string", "pattern": "^P(0[1-9]|10)$" },
    "prompt": { "type": "string", "minLength": 1 },
    "deterministic": { "$ref": "#/$defs/deterministic" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "message"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "unavailable"] },
        "message": { "type": "string" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "assertions"],
      "properties": {
        "name": { "enum": ["functional", "art", "tamperCheck"] },
        "status": { "enum": ["pass", "fail", "unavailable"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        }
      }
    },
    "deterministic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "groups"],
      "properties": {
        "status": { "enum": ["pass", "fail", "unavailable"] },
        "groups": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/group" }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "content"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "role": { "enum": ["source", "fixture_test", "banner", "diff"] },
        "content": { "type": "string" }
      }
    }
  }
}
