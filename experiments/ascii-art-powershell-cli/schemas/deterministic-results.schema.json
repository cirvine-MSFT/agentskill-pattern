{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cirvine-MSFT/agentskill-pattern/ascii-art-powershell-cli/deterministic-results.schema.json",
  "title": "Deterministic acceptance result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolId", "runId", "scheduleId", "promptId", "status", "functional", "art", "tamperCheck", "startedAt", "completedAt"],
  "properties": {
    "protocolId": { "const": "ascii-art-powershell-cli-v1" },
    "runId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)-A[1-2]$" },
    "scheduleId": { "type": "string" },
    "promptId": { "type": "string", "pattern": "^P(0[1-9]|10)$" },
    "status": { "enum": ["pass", "fail", "unavailable"] },
    "functional": { "$ref": "#/$defs/checkGroup" },
    "art": { "$ref": "#/$defs/checkGroup" },
    "tamperCheck": { "$ref": "#/$defs/checkGroup" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "pass" },
        "functional": { "$ref": "#/$defs/passGroup" },
        "art": { "$ref": "#/$defs/passGroup" },
        "tamperCheck": { "$ref": "#/$defs/passGroup" }
      }
    },
    {
      "properties": {
        "status": { "const": "fail" },
        "functional": { "$ref": "#/$defs/availableGroup" },
        "art": { "$ref": "#/$defs/availableGroup" },
        "tamperCheck": { "$ref": "#/$defs/availableGroup" }
      },
      "anyOf": [
        { "properties": { "functional": { "$ref": "#/$defs/failGroup" } } },
        { "properties": { "art": { "$ref": "#/$defs/failGroup" } } },
        { "properties": { "tamperCheck": { "$ref": "#/$defs/failGroup" } } }
      ]
    },
    {
      "properties": { "status": { "const": "unavailable" } },
      "anyOf": [
        { "properties": { "functional": { "$ref": "#/$defs/unavailableGroup" } } },
        { "properties": { "art": { "$ref": "#/$defs/unavailableGroup" } } },
        { "properties": { "tamperCheck": { "$ref": "#/$defs/unavailableGroup" } } }
      ]
    }
  ],
  "$defs": {
    "checkGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["pass", "fail", "unavailable"] },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "message"],
            "properties": {
              "id": { "type": "string" },
              "status": { "enum": ["pass", "fail", "unavailable"] },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "passGroup": {
      "type": "object",
      "properties": { "status": { "const": "pass" } },
      "required": ["status"]
    },
    "failGroup": {
      "type": "object",
      "properties": { "status": { "const": "fail" } },
      "required": ["status"]
    },
    "unavailableGroup": {
      "type": "object",
      "properties": { "status": { "const": "unavailable" } },
      "required": ["status"]
    },
    "availableGroup": {
      "type": "object",
      "properties": { "status": { "enum": ["pass", "fail"] } },
      "required": ["status"]
    }
  }
}
