{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cirvine-MSFT/agentskill-pattern/ascii-art-powershell-cli/deterministic-results.schema.json",
  "title": "Deterministic acceptance result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolId", "runId", "scheduleId", "promptId", "status", "unavailableReason", "functional", "art", "tamperCheck", "startedAt", "completedAt"],
  "properties": {
    "protocolId": { "const": "ascii-art-powershell-cli-v1" },
    "runId": { "type": "string", "pattern": "^P(0[1-9]|10)-R[1-3]-(control|treatment)-A[1-2]$" },
    "scheduleId": { "type": "string" },
    "promptId": { "type": "string", "pattern": "^P(0[1-9]|10)$" },
    "status": { "enum": ["pass", "fail", "unavailable"] },
    "unavailableReason": { "type": ["string", "null"] },
    "functional": { "$ref": "#/$defs/checkGroup" },
    "art": { "$ref": "#/$defs/checkGroup" },
    "tamperCheck": { "$ref": "#/$defs/checkGroup" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "checkGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unavailableReason", "assertions"],
      "properties": {
        "status": { "enum": ["pass", "fail", "unavailable"] },
        "unavailableReason": { "type": ["string", "null"] },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "message"],
            "properties": {
              "id": { "type": "string" },
              "status": { "enum": ["pass", "fail", "unavailable"] },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
